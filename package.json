{
  "name": "watt-watch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-only laptop power meter. Hosted statically; does not run a server on your PC.",
  "scripts": {
    "dev:local": "vite --host 127.0.0.1 --port 18793",
    "start": "node scripts/open-hosted.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 18793",
    "smoke": "node scripts/smoke.mjs",
    "postinstall": "node scripts/fix-rollup-wasm.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.62.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.62.2"
  }
}
